        ]
      }
    },
    "/api/v1/pubg/task/{task_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Task state (see POST /api/v1/pubg/taskStatus)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Task not found"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Poll an async activation task by path (legacy alias of POST /taskStatus)",
        "tags": [
          "Activate PUBG code"
        ]
      }
    },
    "/api/v1/pubg/taskStatus": {
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "task_id": {
                  "example": "3f2a9c1e8b7d4f60a1c2d3e4f5a6b7c8",
                  "type": "string"
                }
              },
              "type": "object"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task state. While running: data.status='pending'. When done: same shape as /activate's data.",
            "schema": {
              "properties": {
                "data": {
                  "properties": {
                    "activated_at": {
                      "nullable": true,
                      "type": "integer"
                    },
                    "activated_to": {
                      "nullable": true,
                      "type": "integer"
                    },
                    "code_activated": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "player_id": {
                      "type": "integer"
                    },
                    "player_name": {
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "pending",
                        "success",
                        "failed",
                        "unknown"
                      ],
                      "type": "string"
                    },
                    "task_id": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "message": {
                  "example": "Ok",
                  "type": "string"
                },
                "success": {
                  "example": true,
                  "type": "boolean"
                }
              },
              "type": "object"
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Task not found"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Poll the status/result of an async activation task (task_id in the body)",
        "tags": [
          "Activate PUBG code"
        ]
      }
    }
  },
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "ApiKeyAuth": {
      "in": "header",
      "name": "X-Api-Key",
      "type": "apiKey"
    }
  },
  "swagger": "2.0"
}